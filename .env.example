# LLM Inference (Required)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Embeddings & Reranking (Runs locally with FastEmbed & FlashRank by default)
# Default model: BAAI/bge-small-en-v1.5 (fast, high precision, runs on CPU via ONNX)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=ms-marco-TinyBERT-L-2-v2

# Optional: Web Search Fallback for Agentic Routing (Tavily AI)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Observability & Tracing via LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=document-qa-agent
